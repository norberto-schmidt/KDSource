text.usetex : True
# text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb} \usepackage{sfmath}

# axes.prop_cycle : (cycler('marker', ['o', 's', '^', 'v', '<', '>', 'd']) + cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e']) + cycler('ls', ['-', '--', ':', '-.', (0,(1,1)), (0,(1,2)), (0,(1,3))]))
axes.prop_cycle : (cycler('color', ['0C5DA5', 'FF9500', '00B945', 'FF2C00', '845B97', '474747', '9e9e9e']) + cycler('ls', ['-', '--', ':', '-.', (0,(1,1)), (0,(1,2)), (0,(1,3))]))

figure.figsize : 6.4, 4.8
figure.dpi : 100

# axes.labelsize: 10
# font.size: 10
# xtick.labelsize: 11
# ytick.labelsize: 11
# legend.fontsize: 10
font.family : serif
# font.serif : Times

axes.grid : True
axes.axisbelow : True
axes.linewidth : 0.5

grid.linestyle : --
grid.color : k
grid.alpha : 0.5
grid.linewidth : 0.5

lines.linewidth : 1.
lines.markersize: 3

legend.frameon : True
legend.framealpha : 1.0
legend.fancybox : True
legend.numpoints : 1

savefig.bbox : tight
# savefig.pad_inches : 0.01